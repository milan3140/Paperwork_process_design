{
  "name": "instavoxel-documents-demo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx scripts/pdf-server.ts\"",
    "dev:vite": "vite",
    "dev:pdf": "tsx scripts/pdf-server.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run src/quote-builder/__tests__/",
    "test:bom": "vitest run src/__tests__/factoryBom.test.ts",
    "test:e2e": "playwright test",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "postcss": "^8.4.47",
    "puppeteer-core": "^24.40.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.8",
    "vitest": "^4.1.1"
  }
}
